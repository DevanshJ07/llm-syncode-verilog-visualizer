SYSTEM_IDENTIFIER: /\$[a-zA-Z_][a-zA-Z0-9_$]*/

// Sized/unsized based numbers and ordinary decimal integers.
NUMBER: /[0-9]*'[sS]?[bBoOdDhH][0-9a-fA-F_xXzZ?]+|[0-9]+/

// SystemVerilog unbased unsized literals used by the benchmark: '0, '1, 'x, 'z.
